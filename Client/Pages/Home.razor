@page "/"
@inject HttpClient Http
@inject IJSRuntime Js

<PageTitle>The Jev Man</PageTitle>

<div class="jevman">
    <p class="tagline">Have you not decided enough for yourself</p>

    <h1>
        <span>The</span>
        <span>Jev</span>
        <span>Man</span>
    </h1>

    <div class="@InputCssClass">
        <label class="question-label" for="question">Seek guidance</label>
        <input id="question"
               class="question-input"
               type="text"
               placeholder="What would you like to ask?"
               @bind="question" />

        <button type="button" class="decide" @onclick="Decide" disabled="@(deciding || !CanDecide)">Decide</button>

        <div class="alternatives">
            <h2>Add an outcome</h2>

            @for (var i = 0; i < alternatives.Count; i++)
            {
                var index = i;
                <div class="alternative">
                    <input id="alt-@index"
                           type="text"
                           placeholder="Alternative @(index + 1)"
                           @bind="alternatives[index]"
                           @onkeydown="e => OnAlternativeKeyDown(index, e)" />
                    <button type="button" class="remove" title="Remove" @onclick="() => RemoveAlternative(index)">×</button>
                </div>
            }
        </div>

        <button type="button" class="add" title="Add alternative" @onclick="AddAlternative">+</button>
    </div>

    @if (result is not null)
    {
        <div class="@ResultCssClass">
            <p class="result-choice">@result.Choice</p>

            @foreach (var alternative in alternatives)
            {
                var probability = result.Probabilities is not null &&
                                  result.Probabilities.TryGetValue(alternative.Trim(), out var p)
                    ? p
                    : 0;

                <div class="result-row">
                    <span class="result-label">@alternative</span>
                    <div class="result-bar">
                        <div class="result-bar-fill" style="width:@(probability * 100)%"></div>
                    </div>
                    <span class="result-percent">@((probability * 100).ToString("0"))%</span>
                </div>
            }

            <p class="confidence-label">Overall confidence</p>
            <div class="result-row">
                <span class="result-label"></span>
                <div class="result-bar">
                    <div class="result-bar-fill" style="width:@(result.Confidence * 100)%"></div>
                </div>
                <span class="result-percent">@((result.Confidence * 100).ToString("0"))%</span>
            </div>

            <button type="button" class="query-again" @onclick="Reset">Query Again</button>
        </div>
    }
</div>

@code {
    private string question = "";

    private List<string> alternatives = new() { "" };

    private DecideResult? result;

    private bool deciding;

    private int? focusIndex;

    private static Home? Current;

    protected override void OnInitialized()
    {
        Current = this;
    }

    [JSInvokable]
    public static void HandleAlternativePaste(int index, string text)
    {
        Current?.ApplyPaste(index, text);
    }

    private void ApplyPaste(int index, string text)
    {
        var lines = text.Split('\n').Select(l => l.TrimEnd('\r')).ToList();

        if (lines.Count > 1 && lines[^1].Length == 0)
        {
            lines.RemoveAt(lines.Count - 1);
        }

        alternatives[index] = lines[0];

        for (var i = 1; i < lines.Count; i++)
        {
            alternatives.Insert(index + i, lines[i]);
        }
    }

    private bool CanDecide =>
        !string.IsNullOrWhiteSpace(question) &&
        alternatives.Any(a => !string.IsNullOrWhiteSpace(a));

    private string InputCssClass => result is null ? "inputs visible" : "inputs hidden";

    private string ResultCssClass => result is not null ? "result shown" : "result";

    private void AddAlternative()
    {
        alternatives.Add("");
    }

    private void RemoveAlternative(int index)
    {
        alternatives.RemoveAt(index);
    }

    private void OnAlternativeKeyDown(int index, KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && index == alternatives.Count - 1)
        {
            alternatives.Add("");
            focusIndex = alternatives.Count - 1;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusIndex is int idx)
        {
            focusIndex = null;
            await Js.InvokeVoidAsync("focusAlternative", $"alt-{idx}");
        }
    }

    private void Reset()
    {
        result = null;
        question = "";
        alternatives = new() { "" };
    }

    private async Task Decide()
    {
        deciding = true;
        try
        {
            var response = await Http.PostAsJsonAsync("api/decide", new { question, alternatives });
            result = await response.Content.ReadFromJsonAsync<DecideResult>();
        }
        finally
        {
            deciding = false;
        }
    }

    public class DecideResult
    {
        public string? Type { get; set; }

        public string? Choice { get; set; }

        public double Confidence { get; set; }

        public Dictionary<string, double>? Probabilities { get; set; }
    }
}
